{
  "schemaVersion": 4,
  "toolchain": { "language": "go", "version": "1.26.6" },
  "extends": [],
  "gates": [
    {
      "name": "full-local-build",
      "command": "go",
      "args": [
        "tool",
        "-modfile",
        "tools/go.mod",
        "quality-gate"
      ],
      "timeout": "15m"
    }
  ],
  "project": {
    "binaries": [
      {
        "package": "./cmd/license",
        "smoke": ["version"]
      }
    ],
    "fuzz": [
      {
        "package": "./internal/domain/placeholder",
        "target": "FuzzUnresolved",
        "time": "50000x"
      },
      {
        "package": "./internal/domain/values",
        "target": "FuzzParse",
        "time": "50000x"
      },
      {
        "package": "./internal/domain/lockfile",
        "target": "FuzzParse",
        "time": "50000x"
      }
    ]
  }
}
